---
import "../styles/global.css";
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header";
import Footer from "../components/Footer";
import Nagas from "../components/Nagas.astro";
import Rept from "../components/Rept.astro";
import Bluelist from "../components/Bluelist.astro";
import FOUR from "../components/FOUR.astro";
import SWAMP from "../components/SWAMP.astro";
import MOON from "../components/MOON.astro";
---

<Layout title="Journey to Truth">
  <Header client:only="react" />
  <main class="container">
    <!-- Jumbotron -->
    <div
      class="bg-linear-to-tl from-indigo-900 to-cyan-700 h-96 w-full relative rounded-xl"
    >
      <img
        src="/images/Med-Bed001.jpg"
        class="w-full h-full object-cover absolute mix-blend-overlay rounded-xl"
      />
      <div class="p-24">
        <h1
          class="text-white text-xl lg:text-[4rem] lg:leading-16 font-bold text-center text-transform: uppercase"
        >Journey to Truth</h1>
        <h2
          class="text-slate-100 text-xl mt-5 text-center text-transform: uppercase"
        >EP 392 | Ex Marine: Michael Selig | Alien Manipulation & Deep State Deceit | Exposing a Covert Evil</h2>
      </div>
    </div>
    <!-- Jumbotron -->

   <!-- EP 392 | Ex Marine: Michael Selig | Alien Manipulation & Deep State Deceit | Exposing a Covert Evil -->
    <div
      class="block px-4 bg-white m-4 shadow-[0_2px_15px_-3px_rgba(0,0,0,0.07),0_10px_20px_-2px_rgba(0,0,0,0.04)] rounded-xl border-r border-b border-l border-gray-400 lg:border-l-0 lg:border-t lg:border-gray-400 rounded-b lg:rounded-b-none lg:rounded-r p-4 justify-between leading-normal"
    >
    <Bluelist />
      <h2 id="alien">
        <p class="mb-4 text-base text-blue-900">EP 392 | Ex Marine: Michael Selig | Alien Manipulation & Deep State Deceit | Exposing a Covert Evil</p>
      </h2>
      <div
        class="content-center bg-white overflow-hidden bg-cover bg-no-repeat"
        data-te-ripple-init
        data-te-ripple-color="light"
      >
        <div
          class="embed-responsive embed-responsive-16by9 relative w-full overflow-hidden"
          style="padding-top: 56.25%"
        >
          <iframe
            class="embed-responsive-item absolute bottom-0 left-0 right-0 top-0 h-full w-full rounded-xl"
            src="https://rumble.com/embed/v6ygdbk/?pub=166b2j"
            allowfullscreen=""
            data-gtm-yt-inspected-2340190_699="true"
            id="240632615"></iframe>
        </div>
      </div>
      <div class="p-6 top-0 text-center">
        <MOON />


        <h5
          class="mb-2 text-xl font-medium leading-tight text-neutral-800 dark:text-neutral-50"
        >
          <a
            href="https://rumble.com/v70n19o-ep-392-ex-marine-michael-selig-alien-manipulation-and-deep-state-deceit-exp.html?"
            rel="noopener"
            target="_blank"
            ><span
              class="text-green-500 text-base hover:text-lg hover:text-purple-700"
              >EP 392 | Ex Marine: Michael Selig | Alien Manipulation & Deep State Deceit | Exposing a Covert Evil</span
            >
          </a>
        </h5>

               <h5
          class="mb-2 text-xl font-medium leading-tight text-neutral-800 dark:text-neutral-50"
        >
          <a
            href="https://rumble.com/c/c-372815?"
            rel="noopener"
            target="_blank"
            ><span
              class="text-green-600 text-base hover:text-lg hover:text-purple-700"
              >Journey to Truth</span
            >
          </a>
        </h5>

        <h5
          class="mb-2 text-xl font-medium leading-tight text-neutral-800 dark:text-neutral-50"
        >
          <a href="./clif#chaos"
            ><span
              class="text-emerald-500 font-bold hover:text-2xl hover:text-green-900"
              >Clif High Interview With Sarah Westall - Aliens, Antarctica, the
              Big Event and even more Chaos</span
            >
          </a>
        </h5>

<h5
  class="mb-2 text-xl font-medium leading-tight text-neutral-800 dark:text-neutral-50"
>
  <a
    href="https://www.youtube.com/watch?v=2pdMsMEQAKI"
    rel="noopener"
    target="_blank"
    ><span
      class="text-slate-800 font-bold hover:text-2xl hover:text-emerald-700"
      >Global Space Force, Cryptos, & Boarding Ships: Alex Collier Shares Answers You Can’t Miss!</span
    >
  </a>
</h5>

   <FOUR />

      </div>
    </div>
    <!-- EP 392 | Ex Marine: Michael Selig | Alien Manipulation & Deep State Deceit | Exposing a Covert Evil -->
    

    <!-- Card title 2 -->
  </main>
</Layout>
<Footer client:only="react" />
