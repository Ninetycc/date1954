import Escapes from "../components/Escapes.astro";
import Patriotchute from "../components/Patriotchute.astro";
import DULCEL from "../components/DULCEL.astro";
import Phil from "../components/Phil.astro";
import Exopolitics from "../components/Exopolitics.astro";
// src/components/VideoPlayer.astro
const videoId1 = "dQw4w9WgXcQ"; // Replace with your YouTube Video ID
const yout = "www.youtube.com"; // Replace with your YouTube Video ID
const bitc = "old.bitchute.com"; // https://old.bitchute.com/video/tf7yPrPKWTs0/
const bright = "www.brighteon.com"; // https://www.brighteon.com/embed/80a26c9d-ed99-488e-ae53-ad9ab8012096
const odysee001 = "https://odysee.com/%24/embed/%40ForEverFree%3A3%2FPhil-Schneider-%E2%80%93-The-Alien-Agenda%2C-The-Grenada-Treaty---The-End-Game%3A6?r=338Hxwp3ojZptb4BLPToH5TZRee9S6gd"; // Phil Schneider – The Alien Agenda, The Grenada Treaty & The End Game
