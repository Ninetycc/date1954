    >
      <img
        src="/images/Med-Bed001.jpg"
        class="w-screen  h-full object-cover absolute mix-blend-overlay rounded-xl"
      />
      <div class="p-24">
        <h1
          class="text-white text-xl  sm:text-[4rem]  sm:leading-16 font-bold text-center text-transform: uppercase"
        >
          DULCE
        </h1>
        <h2 class="text-slate-100 text-xl mt-5 text-center">
          THE DULCE PAPERS: BROWN GREY ALIENS, STAR MAPS & INSECTOIDS
        </h2>
        <a href="https://yandex.com/" rel="noopener" target="_blank">
          <p class="text-left text-yellow-500 hover:text-orange-500">yandex.com</p></a>
      </div>
    </div>
    <!-- Jumbotron -->

    <!-- THE DULCE PAPERS: BROWN GREY ALIENS, STAR MAPS & INSECTOIDS -->
    <div
