        data-te-ripple-init
        data-te-ripple-color="light"
      >
        <div
          class="embed-responsive embed-responsive-16by9 relative w-full overflow-hidden"
          style="padding-top: 0.25%"
        >
 
    <iframe 
    class="w-full aspect-video rounded-2xl shadow-xl border border-white/10" 
    src={`https://${bright}/embed/${videoId1}`} 
    title="YouTube Video Player"
    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
    allowfullscreen
  ></iframe>
        </div>
      </div>
      <div class="p-6 top-0 text-center">

     <THIMEROSALM />
        <Suramin />
      
